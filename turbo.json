{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "APP_ENV", "ENABLED_PLATFORMS", "STAGING_FAKE_CANARY", "RENDER_COST_MODE", "RENDER_USD_PER_MINUTE", "DATABASE_URL", "REDIS_URL", "RUN_*", "S3_*", "STORAGE_PROVIDER",
    "LLM_*", "IMAGE_PROVIDER", "TTS_PROVIDER", "API_BASE_URL",
    "TOPIC_SOURCE_*", "YOUTUBE_*", "INSTAGRAM_*", "TIKTOK_*",
    "OAUTH_ENCRYPTION_*", "PROVIDER_*", "SOCIAL_PUBLISH_*",
    "AUTOMATION_*", "ANALYTICS_*", "WORKER_QUEUES", "MAINTENANCE_WORKER_ENABLED", "QUEUE_RECOVERY_STALE_AFTER_MS", "RENDER_TIMEOUT_MS", "SENTRY_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "apps/web/dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
