{
  "name": "postbot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "backup:mysql": "node --env-file=.env scripts/backup-mysql.mjs",
    "backup:verify": "node scripts/verify-mysql-backup.mjs",
    "backup:restore": "node --env-file=.env scripts/restore-mysql.mjs",
    "recover:queues": "pnpm --filter @postbot/worker recover:queues",
    "baseline:local": "node scripts/local-performance-baseline.mjs",
    "format": "prettier --write ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ],
    "overrides": {
      "deepmerge-ts": "8.0.0",
      "effect": "3.20.0",
      "minimatch@10.2.6>brace-expansion": "5.0.12",
      "@nestjs/swagger>js-yaml": "5.4.1",
      "multer": "2.4.0",
      "proxy-addr": "2.0.8",
      "source-map-js": "1.2.2",
      "qs": "6.16.0"
    },
    "patchedDependencies": {
      "@rspack/core@1.7.11": "patches/@rspack__core@1.7.11.patch"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.19.25",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
