{$POSTBOT_DOMAIN} {
  handle_path /api/* {
    reverse_proxy api-ingress:3000 {
      # Overwrite client input with Caddy's direct peer. There is no trusted CDN
      # in this deployment contract; adding one requires an explicit review.
      header_up X-Forwarded-For {remote_host}
      flush_interval -1
    }
  }
  handle {
    reverse_proxy web:5173
  }
}

# Signed URLs must keep the external Host and canonical path unchanged.
{$POSTBOT_STORAGE_DOMAIN} {
  reverse_proxy {$POSTBOT_STORAGE_UPSTREAM}
}
