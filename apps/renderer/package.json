{
  "name": "@postbot/renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "remotion studio src/remotion-entry.ts --port 3001",
    "build": "tsc -p tsconfig.build.json",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --passWithNoTests"
  },
  "dependencies": {
    "@postbot/scene-schema": "workspace:*",
    "@remotion/bundler": "^4.0.525",
    "@remotion/cli": "^4.0.525",
    "@remotion/renderer": "^4.0.525",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.525",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "vitest": "^4.0.14"
  }
}
