{
  "name": "@postbot/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "recover:queues": "tsx src/recover-queues.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@postbot/asset-library": "workspace:*",
    "@postbot/config": "workspace:*",
    "@postbot/contracts": "workspace:*",
    "@postbot/database": "workspace:*",
    "@postbot/jobs": "workspace:*",
    "@postbot/logger": "workspace:*",
    "@postbot/policy-engine": "workspace:*",
    "@postbot/providers": "workspace:*",
    "@postbot/publishers": "workspace:*",
    "@postbot/renderer": "workspace:*",
    "@postbot/scene-schema": "workspace:*",
    "@sentry/node": "^11.1.0",
    "dotenv": "^17.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "vitest": "^4.0.14"
  }
}
