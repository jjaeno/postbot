    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@postbot/config": "workspace:*",
    "@postbot/contracts": "workspace:*",
    "@postbot/database": "workspace:*",
    "@postbot/jobs": "workspace:*",
    "@postbot/logger": "workspace:*",
    "@postbot/policy-engine": "workspace:*",
    "@postbot/providers": "workspace:*",
    "@postbot/publishers": "workspace:*",
    "@postbot/scene-schema": "workspace:*",
    "@sentry/node": "^11.1.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "vitest": "^4.0.14"
