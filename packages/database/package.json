{
  "name": "@postbot/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:reset:test": "tsx src/scripts/reset-test-db.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --passWithNoTests"
  },
  "devDependencies": {
    "prisma": "6.19.1",
    "tsx": "^4.23.12",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1"
  }
}
