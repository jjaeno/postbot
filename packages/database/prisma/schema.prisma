  finishedAt       DateTime?            @db.DateTime(3)
  createdAt        DateTime             @default(now()) @db.DateTime(3)
  publishPlan      PublishPlan          @relation(fields: [publishPlanId], references: [id], onDelete: Restrict)

  @@unique([publishPlanId, attemptNumber])
  @@index([publishPlanId, status])
  @@map("publish_attempts")
}

model PlatformPost {
  id                 String                    @id @default(cuid())
  publishPlanId      String                    @unique
