  evidence                  Json
  sampleSize                Int
  confidenceScore           Decimal?         @db.Decimal(7, 6)
  expectedImpact            Json?
  targetStrategy            Json?
  risk                      Json?
  inputSnapshot             Json?
  metricVersion             String?          @db.VarChar(80)
  ruleVersion               String?          @db.VarChar(80)
  rollbackStrategyVersionId String?          @db.VarChar(191)
