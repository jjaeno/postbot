  @@map("policy_snapshots")
}

model PublishPlan {
  id                String            @id @default(cuid())
  contentItemId     String
  platform          Platform
  platformAccountId String
  sceneVersionId    String?
  policySnapshotId  String?
  status            PublishPlanStatus @default(DRAFT)
  scheduledAt       DateTime          @db.DateTime(3)
  idempotencyKey    String            @unique @db.VarChar(191)
  title             String            @db.VarChar(255)
  description       String?           @db.Text
  hashtags          Json?
  metadata          Json?
  createdAt         DateTime          @default(now()) @db.DateTime(3)
  updatedAt         DateTime          @updatedAt @db.DateTime(3)
  contentItem       ContentItem       @relation(fields: [contentItemId], references: [id], onDelete: Restrict)
  platformAccount   PlatformAccount   @relation(fields: [platformAccountId], references: [id], onDelete: Restrict)
  sceneVersion      SceneVersion?     @relation(fields: [sceneVersionId], references: [id], onDelete: SetNull)
  policySnapshot    PolicySnapshot?   @relation(fields: [policySnapshotId], references: [id], onDelete: SetNull)
  attempts          PublishAttempt[]
  platformPost      PlatformPost?

  @@index([contentItemId, platform, status])
  @@index([platform, status, scheduledAt])
  @@index([platformAccountId, scheduledAt])
  @@map("publish_plans")
}

