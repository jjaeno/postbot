generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum ChannelStatus {
  ACTIVE
  PAUSED
  ERROR
}

enum AutomationMode {
  APPROVAL
  FULL_AUTO
}

enum Platform {
  YOUTUBE
  INSTAGRAM
  TIKTOK
}

enum PlatformAccountStatus {
  CONNECTED
  EXPIRED
  REVOKED
  DISCONNECTED
}

enum ContentStatus {
  IDEA
  VALIDATING
  GENERATING
  REVIEW_REQUIRED
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  HELD
}

enum IdeaStatus {
  CANDIDATE
  SHORTLISTED
  REJECTED
  USED
  EXPIRED
}

enum SourceKind {
  NEWS
  OFFICIAL
  PAPER
  RSS
  PUBLIC_DATA
  MANUAL
}

enum AssetKind {
  IMAGE
  VIDEO
  AUDIO
  FONT
  GRAPHIC
}

enum AssetOrigin {
  INTERNAL
  STOCK_FREE
  STOCK_PAID
  PUBLIC_DOMAIN
  AI_GENERATED
}

enum LicenseStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum ProductionJobType {
  COLLECT
  SCRIPT
  ASSET
  TTS
  RENDER
  POLICY
  PUBLISH
  ANALYTICS
}

enum ProductionJobStatus {
  QUEUED
  RUNNING
  RETRY_WAIT
  NEEDS_REVIEW
  SUCCEEDED
  FAILED
  CANCEL_REQUESTED
  CANCELLED
}

enum PolicyCheckStatus {
  PASS
  WARNING
  FAIL
  UNKNOWN
}

enum PublishPlanStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  HELD
  CANCELLED
}

enum PublishAttemptStatus {
  QUEUED
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  FAILED
}

enum CostDirection {
  ESTIMATED
  ACTUAL
  CREDIT
}

enum SuggestionStatus {
  PENDING
  PROPOSED
  APPROVED
  REJECTED
  HELD
  APPLIED
  EXPIRED
}

enum ExperimentStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  STOPPED
  INCONCLUSIVE
}

enum AutomationRunStatus {
  QUEUED
  RUNNING
  PAUSED
  DRAINING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AutomationStepStatus {
  PENDING
  QUEUED
  RUNNING
  SUCCEEDED
  HELD
  FAILED
  CANCELLED
  SKIPPED
}

enum AutomationEventAction {
  START
  PAUSE
  RESUME
  DRAIN
  KILL
  RETRY
  HOLD
  AUTO_PAUSE
}

enum AnalyticsMetricStatus {
  AVAILABLE
  UNAVAILABLE
  PARTIAL
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum DataLifecycleRequestType {
  WORKSPACE_DELETE
  USER_DELETE
  RETENTION
}

enum DataLifecycleRequestStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique @db.VarChar(320)
  displayName  String        @db.VarChar(120)
  passwordHash String        @db.VarChar(255)
  timezone     String        @default("Asia/Seoul") @db.VarChar(64)
  createdAt    DateTime      @default(now()) @db.DateTime(3)
  updatedAt    DateTime      @updatedAt @db.DateTime(3)
  memberships  Membership[]
  workspaces   Workspace[]   @relation("WorkspaceOwner")
  authSessions AuthSession[]

  @@map("users")
}

model AuthSession {
  id              String       @id @default(cuid())
  userId          String
  workspaceId     String
  tokenHash       String       @unique @db.VarChar(128)
  familyId        String       @db.VarChar(191)
  replacedById    String?      @unique
  userAgentHash   String?      @db.VarChar(128)
  ipHash          String?      @db.VarChar(128)
  expiresAt       DateTime     @db.DateTime(3)
  revokedAt       DateTime?    @db.DateTime(3)
  reuseDetectedAt DateTime?    @db.DateTime(3)
  createdAt       DateTime     @default(now()) @db.DateTime(3)
  updatedAt       DateTime     @updatedAt @db.DateTime(3)
  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  replacement     AuthSession? @relation("AuthSessionReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replacedSession AuthSession? @relation("AuthSessionReplacement")

  @@index([userId, expiresAt])
  @@index([workspaceId])
  @@index([familyId])
  @@map("auth_sessions")
}

model Workspace {
  id                 String                 @id @default(cuid())
  ownerId            String
  name               String                 @db.VarChar(120)
  slug               String                 @unique @db.VarChar(80)
  createdAt          DateTime               @default(now()) @db.DateTime(3)
  updatedAt          DateTime               @updatedAt @db.DateTime(3)
  owner              User                   @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships        Membership[]
  channels           Channel[]
  platformAccounts   PlatformAccount[]
  authSessions       AuthSession[]
  oauthStates        OAuthConnectionState[]
  automationBudgets  AutomationBudget[]
  automationSwitches AutomationSwitch[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  budgetHistories    BudgetHistory[]

  @@index([ownerId])
  @@map("workspaces")
}

model OAuthConnectionState {
  id                    String    @id @default(cuid())
  workspaceId           String
  channelId             String?
  platform              Platform
  stateHash             String    @unique @db.VarChar(128)
  encryptedCodeVerifier String    @db.Text
  tokenCipher           String    @db.VarChar(64)
  tokenKeyVersion       Int
  scopes                Json
  redirectUri           String    @db.VarChar(512)
  provider              String    @db.VarChar(40)
  expiresAt             DateTime  @db.DateTime(3)
  usedAt                DateTime? @db.DateTime(3)
  createdAt             DateTime  @default(now()) @db.DateTime(3)
  updatedAt             DateTime  @updatedAt @db.DateTime(3)
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  channel               Channel?  @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([workspaceId, platform, expiresAt])
  @@index([channelId])
  @@map("oauth_connection_states")
}

model Membership {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now()) @db.DateTime(3)
  updatedAt   DateTime      @updatedAt @db.DateTime(3)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

model Channel {
  id                      String                   @id @default(cuid())
  workspaceId             String
  name                    String                   @db.VarChar(120)
  slug                    String                   @db.VarChar(80)
  description             String?                  @db.Text
  language                String                   @default("ko") @db.VarChar(16)
  targetAudience          String?                  @db.VarChar(255)
  topic                   String?                  @db.VarChar(255)
  excludedTopics          Json?
  status                  ChannelStatus            @default(ACTIVE)
  automationMode          AutomationMode           @default(APPROVAL)
  minInventoryCount       Int                      @default(3)
  dailyPublishLimit       Int                      @default(1)
  errorAction             Json?
  optimizationSettings    Json?
  createdAt               DateTime                 @default(now()) @db.DateTime(3)
  updatedAt               DateTime                 @updatedAt @db.DateTime(3)
  workspace               Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  platformAccounts        PlatformAccount[]
  templates               ChannelTemplate[]
  collectionRules         CollectionRule[]
  outputProfiles          PlatformOutputProfile[]
  scheduleRules           ScheduleRule[]
  contentItems            ContentItem[]
  contentIdeas            ContentIdea[]
  assets                  Asset[]
  productionJobs          ProductionJob[]
  policySnapshots         PolicySnapshot[]
  oauthStates             OAuthConnectionState[]
  strategyVersions        StrategyVersion[]
  experiments             Experiment[]
  optimizationSuggestions OptimizationSuggestion[]
  automationRuns          AutomationRun[]
  automationBudgets       AutomationBudget[]
  analyticsSyncs          AnalyticsSync[]
  notifications           Notification[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
  @@map("channels")
}

model ContentIdea {
  id                 String       @id @default(cuid())
  channelId          String
  status             IdeaStatus   @default(CANDIDATE)
  title              String       @db.VarChar(255)
  summary            String?      @db.Text
  canonicalUrl       String       @db.Text
  urlHash            String       @db.VarChar(128)
  contentHash        String       @db.VarChar(128)
  sourceName         String       @db.VarChar(191)
  sourceKind         SourceKind
  provider           String       @db.VarChar(80)
  publishedAt        DateTime?    @db.DateTime(3)
  collectedAt        DateTime     @default(now()) @db.DateTime(3)
  suitabilityScore   Decimal      @db.Decimal(7, 6)
  freshnessScore     Decimal      @db.Decimal(7, 6)
  reliabilityScore   Decimal      @db.Decimal(7, 6)
  expectedValueScore Decimal      @db.Decimal(7, 6)
  rejectionReason    String?      @db.Text
  rawSnapshot        Json?
  usedContentItemId  String?      @unique
  createdAt          DateTime     @default(now()) @db.DateTime(3)
  updatedAt          DateTime     @updatedAt @db.DateTime(3)
  channel            Channel      @relation(fields: [channelId], references: [id], onDelete: Restrict)
  usedContentItem    ContentItem? @relation(fields: [usedContentItemId], references: [id], onDelete: SetNull)

  @@unique([channelId, urlHash])
  @@unique([channelId, contentHash])
  @@index([channelId, status, collectedAt])
  @@index([sourceKind, publishedAt])
  @@map("content_ideas")
}

model CollectionRule {
  id                         String   @id @default(cuid())
  channelId                  String
  version                    Int      @default(1)
  keywords                   Json
  excludedKeywords           Json?
  allowedSources             Json?
  excludedSources            Json?
  recencyHours               Int
  collectionFrequencyMinutes Int
  isActive                   Boolean  @default(true)
  createdAt                  DateTime @default(now()) @db.DateTime(3)
  updatedAt                  DateTime @updatedAt @db.DateTime(3)
  channel                    Channel  @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@unique([channelId, version])
  @@index([channelId, isActive])
  @@map("collection_rules")
}

model PlatformAccount {
  id                String                @id @default(cuid())
  workspaceId       String
  channelId         String?
  platform          Platform
  externalAccountId String                @db.VarChar(191)
  handle            String?               @db.VarChar(191)
  displayName       String?               @db.VarChar(191)
  status            PlatformAccountStatus @default(CONNECTED)
  connectedAt       DateTime?             @db.DateTime(3)
  disconnectedAt    DateTime?             @db.DateTime(3)
  createdAt         DateTime              @default(now()) @db.DateTime(3)
  updatedAt         DateTime              @updatedAt @db.DateTime(3)
  channel           Channel?              @relation(fields: [channelId], references: [id], onDelete: Restrict)
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  credential        OAuthCredential?
  publishPlans      PublishPlan[]
  platformPosts     PlatformPost[]

  @@unique([workspaceId, platform, externalAccountId])
  @@unique([channelId, platform])
  @@index([workspaceId, platform, status])
  @@map("platform_accounts")
}

model OAuthCredential {
  id                    String          @id @default(cuid())
  platformAccountId     String          @unique
  encryptedAccessToken  String          @db.Text
  encryptedRefreshToken String?         @db.Text
  tokenCipher           String          @db.VarChar(64)
  tokenKeyVersion       Int
  scopeHash             String          @db.VarChar(128)
  scopes                Json
  expiresAt             DateTime?       @db.DateTime(3)
  lastRefreshedAt       DateTime?       @db.DateTime(3)
  createdAt             DateTime        @default(now()) @db.DateTime(3)
  updatedAt             DateTime        @updatedAt @db.DateTime(3)
  platformAccount       PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@map("oauth_credentials")
}

model ChannelTemplate {
  id            String   @id @default(cuid())
  channelId     String
  version       Int
  name          String   @db.VarChar(120)
  tone          String?  @db.VarChar(120)
  voiceProfile  String?  @db.VarChar(120)
  subtitleStyle Json?
  visualStyle   Json?
  aiStockRatio  Decimal  @default(0.500000) @db.Decimal(7, 6)
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.DateTime(3)
  updatedAt     DateTime @updatedAt @db.DateTime(3)
  channel       Channel  @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@unique([channelId, version])
  @@index([channelId, isActive])
  @@map("channel_templates")
}

model PlatformOutputProfile {
  id                 String   @id @default(cuid())
  channelId          String
  platform           Platform
  version            Int      @default(1)
  minDurationSeconds Int      @default(30)
  maxDurationSeconds Int      @default(90)
  hookStyle          String?  @db.VarChar(120)
  captionStyle       String?  @db.VarChar(120)
  metadataRules      Json?
  publicSetting      String   @default("PUBLIC") @db.VarChar(40)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.DateTime(3)
  updatedAt          DateTime @updatedAt @db.DateTime(3)
  channel            Channel  @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@unique([channelId, platform, version])
  @@index([channelId, platform, isActive])
  @@map("platform_output_profiles")
}

model ScheduleRule {
  id           String    @id @default(cuid())
  channelId    String
  platform     Platform?
  dayOfWeek    Int
  timeOfDayUtc String    @db.VarChar(8)
  timezone     String    @default("Asia/Seoul") @db.VarChar(64)
  maxPosts     Int       @default(1)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @db.DateTime(3)
  channel      Channel   @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@index([channelId, platform, isActive])
  @@map("schedule_rules")
}

model ContentItem {
  id                      String                   @id @default(cuid())
  channelId               String
  status                  ContentStatus            @default(IDEA)
  title                   String                   @db.VarChar(255)
  summary                 String?                  @db.Text
  topicKey                String                   @db.VarChar(191)
  eventAt                 DateTime?                @db.DateTime(3)
  collectedAt             DateTime?                @db.DateTime(3)
  riskLevel               Int                      @default(0)
  suitabilityScore        Decimal?                 @db.Decimal(7, 6)
  duplicateGroupKey       String?                  @db.VarChar(191)
  approvedAt              DateTime?                @db.DateTime(3)
  heldReason              String?                  @db.Text
  failureReason           String?                  @db.Text
  createdAt               DateTime                 @default(now()) @db.DateTime(3)
  updatedAt               DateTime                 @updatedAt @db.DateTime(3)
  channel                 Channel                  @relation(fields: [channelId], references: [id], onDelete: Restrict)
  sourceReferences        SourceReference[]
  contentIdeas            ContentIdea[]
  scriptVersions          ScriptVersion[]
  sceneVersions           SceneVersion[]
  assetUsages             AssetUsage[]
  productionJobs          ProductionJob[]
  policyChecks            PolicyCheck[]
  publishPlans            PublishPlan[]
  providerUsages          ProviderUsage[]
  costLedger              CostLedger[]
  strategyVersions        StrategyVersion[]
  optimizationSuggestions OptimizationSuggestion[]
  experiments             Experiment[]
  experimentAssignments   ExperimentAssignment[]

  @@unique([channelId, topicKey])
  @@index([channelId, status, createdAt])
  @@index([channelId, duplicateGroupKey])
  @@map("content_items")
}

model SourceReference {
  id                 String      @id @default(cuid())
  contentItemId      String
  kind               SourceKind
  title              String      @db.VarChar(255)
  url                String      @db.Text
  urlHash            String      @db.VarChar(128)
  sourceName         String      @db.VarChar(191)
  author             String?     @db.VarChar(191)
  publishedAt        DateTime?   @db.DateTime(3)
  eventAt            DateTime?   @db.DateTime(3)
  reliabilityScore   Decimal?    @db.Decimal(7, 6)
  isPrimary          Boolean     @default(false)
  normalizedSnapshot Json?
  createdAt          DateTime    @default(now()) @db.DateTime(3)
  contentItem        ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Restrict)

  @@unique([contentItemId, urlHash])
  @@index([kind, publishedAt])
  @@map("source_references")
}

model ScriptVersion {
  id              String         @id @default(cuid())
  contentItemId   String
  version         Int
  platform        Platform?
  hook            String         @db.Text
  body            String         @db.Text
  callToAction    String?        @db.Text
  language        String         @default("ko") @db.VarChar(16)
  durationSeconds Decimal?       @db.Decimal(8, 3)
  promptVersion   String?        @db.VarChar(80)
  qualitySnapshot Json?
  approvedAt      DateTime?      @db.DateTime(3)
  createdAt       DateTime       @default(now()) @db.DateTime(3)
  contentItem     ContentItem    @relation(fields: [contentItemId], references: [id], onDelete: Restrict)
  sceneVersions   SceneVersion[]

  @@unique([contentItemId, platform, version])
  @@index([contentItemId, createdAt])
  @@map("script_versions")
}

model SceneVersion {
  id              String         @id @default(cuid())
  contentItemId   String
  scriptVersionId String?
  version         Int
  schemaVersion   String         @db.VarChar(40)
  platform        Platform?
  sceneDocument   Json
  renderManifest  Json?
  durationSeconds Decimal?       @db.Decimal(8, 3)
  createdAt       DateTime       @default(now()) @db.DateTime(3)
  contentItem     ContentItem    @relation(fields: [contentItemId], references: [id], onDelete: Restrict)
  scriptVersion   ScriptVersion? @relation(fields: [scriptVersionId], references: [id], onDelete: SetNull)
  publishPlans    PublishPlan[]
  assetUsages     AssetUsage[]

  @@unique([contentItemId, platform, version])
  @@index([scriptVersionId])
  @@map("scene_versions")
}

model Asset {
  id              String         @id @default(cuid())
  channelId       String?
  kind            AssetKind
  origin          AssetOrigin
  storageKey      String         @db.VarChar(512)
  checksumSha256  String         @db.VarChar(64)
  dedupScope      String         @default("global") @db.VarChar(191)
  mimeType        String         @db.VarChar(120)
  width           Int?
  height          Int?
  durationSeconds Decimal?       @db.Decimal(8, 3)
  hasWatermark    Boolean        @default(false)
  createdAt       DateTime       @default(now()) @db.DateTime(3)
  updatedAt       DateTime       @updatedAt @db.DateTime(3)
  channel         Channel?       @relation(fields: [channelId], references: [id], onDelete: SetNull)
  sources         AssetSource[]
  licenses        AssetLicense[]
  usages          AssetUsage[]

  @@unique([dedupScope, checksumSha256])
  @@index([channelId, kind, origin])
  @@map("assets")
}

model AssetSource {
  id               String    @id @default(cuid())
  assetId          String
  provider         String    @db.VarChar(80)
  model            String?   @db.VarChar(120)
  prompt           String?   @db.Text
  sourceUrl        String?   @db.Text
  creator          String?   @db.VarChar(191)
  downloadedAt     DateTime? @db.DateTime(3)
  providerResponse Json?
  createdAt        DateTime  @default(now()) @db.DateTime(3)
  asset            Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([assetId, provider])
  @@map("asset_sources")
}

model AssetLicense {
  id                   String        @id @default(cuid())
  assetId              String
  status               LicenseStatus @default(PENDING)
  licenseName          String        @db.VarChar(191)
  commercialUseAllowed Boolean       @default(false)
  derivativeAllowed    Boolean       @default(false)
  attributionRequired  Boolean       @default(false)
  attributionText      String?       @db.Text
  proofUrl             String?       @db.Text
  validFrom            DateTime?     @db.DateTime(3)
  validUntil           DateTime?     @db.DateTime(3)
  checkedAt            DateTime?     @db.DateTime(3)
  createdAt            DateTime      @default(now()) @db.DateTime(3)
  asset                Asset         @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([assetId, status, checkedAt])
  @@map("asset_licenses")
}

model AssetUsage {
  id             String        @id @default(cuid())
  assetId        String
  contentItemId  String
  sceneVersionId String?
  purpose        String        @db.VarChar(120)
  usageSnapshot  Json?
  createdAt      DateTime      @default(now()) @db.DateTime(3)
  asset          Asset         @relation(fields: [assetId], references: [id], onDelete: Restrict)
  contentItem    ContentItem   @relation(fields: [contentItemId], references: [id], onDelete: Restrict)
  sceneVersion   SceneVersion? @relation(fields: [sceneVersionId], references: [id], onDelete: SetNull)

  @@unique([assetId, contentItemId, purpose])
  @@index([contentItemId])
  @@map("asset_usages")
}

model ProductionJob {
  id              String              @id @default(cuid())
  channelId       String?
  contentItemId   String?
  type            ProductionJobType
  status          ProductionJobStatus @default(QUEUED)
  queueName       String              @db.VarChar(80)
  idempotencyKey  String              @unique @db.VarChar(191)
  payload         Json
  result          Json?
  errorCode       String?             @db.VarChar(80)
  errorMessage    String?             @db.Text
  runAfter        DateTime?           @db.DateTime(3)
  startedAt       DateTime?           @db.DateTime(3)
  finishedAt      DateTime?           @db.DateTime(3)
  createdAt       DateTime            @default(now()) @db.DateTime(3)
  updatedAt       DateTime            @updatedAt @db.DateTime(3)
  channel         Channel?            @relation(fields: [channelId], references: [id], onDelete: SetNull)
  contentItem     ContentItem?        @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  attempts        JobAttempt[]
  providerUsages  ProviderUsage[]
  automationSteps AutomationStep[]

  @@index([queueName, status, runAfter])
  @@index([contentItemId, type, status])
  @@map("production_jobs")
}

model AutomationRun {
  id               String                      @id @default(cuid())
  channelId        String
  status           AutomationRunStatus         @default(QUEUED)
  idempotencyKey   String                      @unique @db.VarChar(191)
  checkpoint       Json?
  budgetReserved   Decimal                     @default(0) @db.Decimal(18, 6)
  budgetActual     Decimal                     @default(0) @db.Decimal(18, 6)
  failureCount     Int                         @default(0)
  pausedReason     String?                     @db.Text
  nextRunAt        DateTime?                   @db.DateTime(3)
  heartbeatAt      DateTime?                   @db.DateTime(3)
  lastErrorCode    String?                     @db.VarChar(80)
  lastErrorMessage String?                     @db.Text
  createdAt        DateTime                    @default(now()) @db.DateTime(3)
  updatedAt        DateTime                    @updatedAt @db.DateTime(3)
  channel          Channel                     @relation(fields: [channelId], references: [id], onDelete: Restrict)
  steps            AutomationStep[]
  reservations     AutomationCostReservation[]
  events           AutomationEvent[]

  @@index([channelId, status, createdAt])
  @@map("automation_runs")
}

model AutomationStep {
  id              String               @id @default(cuid())
  automationRunId String
  stage           ProductionJobType
  platform        Platform?
  branchKey       String               @default("COMMON") @db.VarChar(16)
  status          AutomationStepStatus @default(PENDING)
  productionJobId String?              @unique
  attemptCount    Int                  @default(0)
  maxAttempts     Int                  @default(3)
  output          Json?
  errorCode       String?              @db.VarChar(80)
  errorMessage    String?              @db.Text
  startedAt       DateTime?            @db.DateTime(3)
  finishedAt      DateTime?            @db.DateTime(3)
  createdAt       DateTime             @default(now()) @db.DateTime(3)
  updatedAt       DateTime             @updatedAt @db.DateTime(3)
  automationRun   AutomationRun        @relation(fields: [automationRunId], references: [id], onDelete: Restrict)
  productionJob   ProductionJob?       @relation(fields: [productionJobId], references: [id], onDelete: SetNull)

  @@unique([automationRunId, stage, branchKey])
  @@index([automationRunId, status])
  @@index([automationRunId, platform, status])
  @@map("automation_steps")
}

model AutomationBudget {
  id               String          @id @default(cuid())
  workspaceId      String
  channelId        String?
  currency         String          @default("USD") @db.VarChar(3)
  dailySoftLimit   Decimal?        @db.Decimal(18, 6)
  dailyHardLimit   Decimal?        @db.Decimal(18, 6)
  monthlySoftLimit Decimal?        @db.Decimal(18, 6)
  monthlyHardLimit Decimal?        @db.Decimal(18, 6)
  createdAt        DateTime        @default(now()) @db.DateTime(3)
  updatedAt        DateTime        @updatedAt @db.DateTime(3)
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  channel          Channel?        @relation(fields: [channelId], references: [id], onDelete: Restrict)
  histories        BudgetHistory[]

  @@unique([workspaceId, channelId])
  @@map("automation_budgets")
}

model BudgetHistory {
