  @@unique([platform, externalPostId])
  @@index([platformAccountId, publishedAt])
  @@map("platform_posts")
}

model AnalyticsSync {
  id             String                    @id @default(cuid())
  channelId      String
  platform       Platform
  status         String                    @db.VarChar(32)
  idempotencyKey String                    @unique @db.VarChar(191)
  periodStart    DateTime                  @db.DateTime(3)
  periodEnd      DateTime                  @db.DateTime(3)
  timezone       String                    @db.VarChar(64)
  syncedAt       DateTime                  @default(now()) @db.DateTime(3)
  dataDelayHours Int?
  errorCode      String?                   @db.VarChar(80)
  errorMessage   String?                   @db.Text
  channel        Channel                   @relation(fields: [channelId], references: [id], onDelete: Restrict)
  snapshots      AnalyticsMetricSnapshot[]

  @@index([channelId, platform, periodStart])
  @@map("analytics_syncs")
}

model AnalyticsMetricSnapshot {
  id                String                @id @default(cuid())
  analyticsSyncId   String
  platformPostId    String
  metric            String                @db.VarChar(80)
  mappingVersion    String                @db.VarChar(40)
  status            AnalyticsMetricStatus
  value             Decimal?              @db.Decimal(20, 6)
  unit              String?               @db.VarChar(40)
  aggregation       String?               @db.VarChar(40)
  unavailableReason String?               @db.Text
  rawSnapshot       Json
  observedAt        DateTime              @db.DateTime(3)
  revision          Int                   @default(1)
  createdAt         DateTime              @default(now()) @db.DateTime(3)
  analyticsSync     AnalyticsSync         @relation(fields: [analyticsSyncId], references: [id], onDelete: Restrict)
  platformPost      PlatformPost          @relation(fields: [platformPostId], references: [id], onDelete: Restrict)

  @@unique([analyticsSyncId, platformPostId, metric, observedAt, revision], map: "analytics_snapshot_sync_post_metric_observed_revision_key")
  @@index([platformPostId], map: "analytics_snapshot_post_idx")
  @@index([analyticsSyncId, metric])
  @@map("analytics_metric_snapshots")
}

