[Unit]
Description=Postbot encrypted database backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=postbot-backup
WorkingDirectory=/opt/postbot
EnvironmentFile=/etc/postbot/backup.env
ExecStart=/usr/bin/node scripts/scheduled-backup.mjs
TimeoutStartSec=2h
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/postbot-backup
